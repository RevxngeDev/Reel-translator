GROQ_API_KEY=
# Optional, set at most one (D-013). Cookies of a dedicated secondary account only.
# Path to a Netscape-format cookies.txt kept OUTSIDE the repository:
YTDLP_COOKIES_FILE=
# Or a local browser name to read cookies from (e.g. firefox):
YTDLP_COOKIES_BROWSER=
# Telegram bot (Phase 2)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_WHITELIST=
# Optional, default data/bot.sqlite3
BOT_DB_PATH=
# Optional HTTP proxy for the Telegram API (where Telegram is blocked)
TELEGRAM_PROXY=
